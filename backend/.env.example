# ─────────────────────────────────────────────────────────────────────────────
#  Smart Dental Desk — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret for signing our own tokens (make this a long random string)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# Server
PORT=3001
NODE_ENV=development

# Frontend origin for CORS (change in production)
FRONTEND_ORIGIN=http://localhost:5500

# Password reset redirect — the page Supabase sends users to after clicking the reset email link
# Must be an absolute URL and added to your Supabase project's "Redirect URLs" allowlist
# Supabase Dashboard → Authentication → URL Configuration → Redirect URLs
RESET_PASSWORD_REDIRECT=https://your-frontend-domain.com/reset-password.html


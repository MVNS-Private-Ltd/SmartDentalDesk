# ─────────────────────────────────────────────────────────────────────────────
#  DentalSmart — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret for signing our own tokens (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# Server
PORT=3001
NODE_ENV=development

# Frontend origin for CORS (change to your deployed frontend URL in production — never use * in prod)
FRONTEND_ORIGIN=https://www.dentalsmart.tech

# Super Admin / SaaS Owner emails (comma-separated)
SUPER_ADMIN_EMAILS=your_email@example.com

# Google OAuth redirect URI (must match Supabase Dashboard > Auth > URL Configuration)
OAUTH_REDIRECT=https://www.dentalsmart.tech/login.html

# Supabase Postgres direct connection (for migration scripts)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── Email Infrastructure (Resend API) ─────────────────────────────────────────
# We use Resend (HTTP API) to bypass SMTP port blocks on Render/Vercel.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=DentalSmart

# AI Token Billing Options
TOKENS_PER_CREDIT=500
MODEL_FACTORS="{\"nano\":1,\"standard\":1.5,\"super\":2}"

# Legal Configuration (served by /api/config to frontend)
# Non-secret public values. Set in Render environment variables.
LEGAL_BUSINESS_NAME=
REGISTERED_ADDRESS=
SUPPORT_EMAIL=
PRIVACY_EMAIL=
GRIEVANCE_EMAIL=
EFFECTIVE_DATE=
GOVERNING_LAW=
DATA_SUBPROCESSORS=Supabase, Render, OpenRouter

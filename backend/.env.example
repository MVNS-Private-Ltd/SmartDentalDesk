# ─────────────────────────────────────────────────────────────────────────────
#  Smart Dental Desk — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — get from: https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT secret for signing our own tokens (generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# Server
PORT=3001
NODE_ENV=development

# Frontend origin for CORS (change to your deployed frontend URL in production — never use * in prod)
FRONTEND_ORIGIN=http://localhost:5500

# Super Admin / SaaS Owner emails (comma-separated)
SUPER_ADMIN_EMAILS=your_email@example.com

# Google OAuth redirect URI (must match Supabase Dashboard > Auth > URL Configuration)
OAUTH_REDIRECT=http://localhost:5500/login.html

# Supabase Postgres direct connection (for migration scripts)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres

# ── SMTP (Gmail) — for AI automation email sending to patients ────────────────
# Use your Gmail address + a Gmail App Password (NOT your regular Gmail password)
# How to generate App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification
#   2. Scroll down → App Passwords → Select "Mail" → Generate
# Add SMTP_USER and SMTP_PASS to Render environment variables for production.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM_NAME=Smart Dental Desk
